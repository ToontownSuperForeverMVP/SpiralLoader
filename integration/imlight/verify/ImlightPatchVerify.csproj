<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Imlight patch verification harness. Compiles the REAL patched Imlight Director Program.cs, the modding files,
    the session plumbing (SessionActor, MessageService, ReceiveProtocolDispatcher, MessageHandlerTable) and the
    hook call-site services against functional stubs for the Imcodec-generated types, sockets and databases, then
    runs Program.Main. Scenarios.cs drives real sessions with synthetic client packets. Separately compiled test
    mods (VerifyMod, ClientProcessMod, IsolationMod, DuplicateClaimMod) see only the public surface, as a mod
    built against Imlight.CoreLib would.

    It does NOT prove that the patched Imlight.CoreLib compiles as a whole (call sites in LootGranter and
    CommandDispatcher are not compiled here). That requires a local build with the Imcodec type dump.

    Usage: integration/imlight/verify/verify-patch.sh (or Verify-Patch.ps1).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Imlight.Director.Verify</AssemblyName>
    <RootNamespace>Imlight.Director</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Real Imlight packet files compiled here leave unassigned fields (set by generated code at runtime); stubs ignore ctor args. -->
    <NoWarn>$(NoWarn);CS0649;CS9113</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImlightSourceRoot Condition="'$(ImlightSourceRoot)' == ''">$(SpiralLoaderRepoRoot)external/Imlight/</ImlightSourceRoot>
    <!-- ImlightSourceRoot may be a global (command-line) property, which cannot be reassigned here. -->
    <_Imlight>$([MSBuild]::EnsureTrailingSlash('$(ImlightSourceRoot)'))src/</_Imlight>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="ImcodecStubs.cs" />
    <Compile Include="Scenarios.cs" />
    <!-- The reflection describer shared with the test project and the SpiralLoader.ApiSurface tool. -->
    <Compile Include="$(SpiralLoaderRepoRoot)tools/SpiralLoader.ApiSurface/PublicApiSurface.cs" />
    <Compile Include="$(_Imlight)Imlight.Director/Program.cs" />
    <Compile Include="$(_Imlight)Imlight.Director/AkkaConfiguration.cs" />
    <Compile Include="$(_Imlight)Imlight.Director/ResourceContainer.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Modding/ImlightModding.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Modding/ImlightEvents.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Modding/ModMessageService.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Utilities/AssemblyTypes.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Game/Zone/Core/ZoneEntityComponentRegistry.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Game/GameServiceFactory.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Login/LoginServiceFactory.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/ServiceFactory.cs" />
    <!-- Real Imlight files for the hook call sites (their Imcodec-generated dependencies are stubbed in Stubs.cs). -->
    <!-- The real session plumbing: a client packet goes SessionActor.HandlePacket -> dispatch table -> service. -->
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/SessionActor.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/MessageService.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/Exceptions.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/IHandshakeService.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Packets/ACCOUNT_104_PROTOCOL.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/WizardData/Models/Misc/OnlinePlayer.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/ReceiveProtocolDispatcher.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/MessageHandlerTable.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Networking/ServerInterfaces.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Packets/SERVER_100_PROTOCOL.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Packets/PROCESS_107_PROTOCOL.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Shared/Packets/SERVICE_101_PROTOCOL.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Login/Services/CharacterService.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Login/Services/GameTransitionService.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Game/Services/MinigameService.cs" />
    <Compile Include="$(_Imlight)Imlight.CoreLib/Game/Processes/ProcessSupervisor.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.33" />
    <ProjectReference Include="$(_Imlight)Imlight.Common/Imlight.Common.csproj" />
    <ProjectReference Include="$(SpiralLoaderRepoRoot)src/SpiralLoader.Imlight/SpiralLoader.Imlight.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(_Imlight)Imlight.Director/Config/Imlight.ini" Link="Config/Imlight.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="akka.conf" Link="Config/akka.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyImlightCheckout" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(_Imlight)Imlight.CoreLib/Modding/ImlightModding.cs')"
           Text="No patched Imlight checkout at '$(ImlightSourceRoot)'. Run integration/imlight/setup-imlight.sh (or pass -p:ImlightSourceRoot=...)." />
  </Target>
</Project>

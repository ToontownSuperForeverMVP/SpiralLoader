@@ -36,7 +36,9 @@
  * NOTE:
  * Mod services are plain objects owned by the host actor: their handlers run synchronously inside the host's
  * message processing, one message at a time, like any other service. An exception from a mod service is
- * logged against its mod and does not stop the session or the other services.
+ * logged against its mod and does not stop the session or the other services. Client process traffic
+ * (MSG_MESSAGE_PROCESS, MSG_CLIENT_PROCESS_TERMINATED) reaches only the services of the mod that claimed the
+ * job id in ImlightRegistries.ClientProcessJobs.
  *
  * TODO:
  *
@@ -50,6 +52,7 @@ using System.Collections.Concurrent;
 using System.Collections.Generic;
 using System.Reflection;
 using Imcodec.MessageLayer;
+using Imcodec.MessageLayer.Generated;
 using Imlight.Common;
 using Imlight.CoreLib.Shared.Networking;
 using Imlight.CoreLib.WizardData.Models.Player;
@@ -96,6 +99,26 @@ public abstract class ModMessageService {
     /// </summary>
     protected Account GetSocketAccount() => Host.GetAccount();
 
+    /// <summary>
+    /// Starts the client script <paramref name="scriptName"/> (for example <c>MyMod/Menu.lua</c>) as client process
+    /// <paramref name="jobId"/>. The id must be claimed by this service's mod in
+    /// <see cref="ImlightRegistries.ClientProcessJobs"/>; the client's replies then arrive as
+    /// <c>GAME_5_PROTOCOL.MSG_MESSAGE_PROCESS</c> at this mod's services.
+    /// </summary>
+    /// <exception cref="InvalidOperationException">This mod did not claim <paramref name="jobId"/>.</exception>
+    protected void StartClientProcess(uint jobId, string scriptName) {
+        ArgumentException.ThrowIfNullOrEmpty(scriptName);
+
+        var owner = ImlightModding.GetClientProcessJobOwner(jobId);
+        if (owner != OwnerModId) {
+            throw new InvalidOperationException(owner is null
+                ? $"Client process job id {jobId} is not claimed by mod {OwnerModId}."
+                : $"Client process job id {jobId} belongs to mod {owner}, not {OwnerModId}.");
+        }
+
+        Host.SendToClient(new GAME_5_PROTOCOL.MSG_START_CLIENT_PROCESS { JobID = jobId, ScriptName = scriptName });
+    }
+
     /// <summary>
     /// Called once when the session ends, while the session's other services still run (Imlight's pre-dispose
     /// step, which waits at most two seconds for all services). Release per-session state here; keep it short.
@@ -175,9 +198,15 @@ internal abstract class ModMessageServiceHost : MessageService {
             handled = true;
         }
 
+        // Client process traffic belongs to the mod that claimed its job id; an unclaimed id is Imlight's own
+        // (minigames), so no mod service sees it.
+        var jobOwner = TryGetJobId(message, out var jobId)
+            ? ImlightModding.GetClientProcessJobOwner(jobId) ?? string.Empty
+            : null;
+
         foreach (var (service, ownerModId) in _services) {
             var handler = MessageHandlerTable.DispatcherFor(service.GetType(), messageType);
-            if (handler is null) {
+            if (handler is null || (jobOwner is not null && jobOwner != ownerModId)) {
                 continue;
             }
 
@@ -195,6 +224,20 @@ internal abstract class ModMessageServiceHost : MessageService {
         }
     }
 
+    private static bool TryGetJobId(object message, out uint jobId) {
+        switch (message) {
+            case GAME_5_PROTOCOL.MSG_MESSAGE_PROCESS process:
+                jobId = process.JobID;
+                return true;
+            case GAME_5_PROTOCOL.MSG_CLIENT_PROCESS_TERMINATED terminated:
+                jobId = terminated.JobID;
+                return true;
+            default:
+                jobId = 0;
+                return false;
+        }
+    }
+
     /// <summary>The registered mod service types of one host type, and the message types they handle.</summary>
     private sealed class ServiceSet {
 

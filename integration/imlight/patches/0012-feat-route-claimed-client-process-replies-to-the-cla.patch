From 75b98cac777b4f19b12165c8ef1232f9e33034c1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 00:21:12 +0000
Subject: [PATCH 12/13] feat: route claimed client process replies to the
 claiming mod

MSG_MESSAGE_PROCESS and MSG_CLIENT_PROCESS_TERMINATED carry a job id.
The mod service host now delivers them only to the services of the mod
that claimed that id in imlight:client_process_jobs; a reply for an
unclaimed id reaches no mod service and stays with MinigameService, as
before. ModMessageService.StartClientProcess sends
MSG_START_CLIENT_PROCESS for an id the service's own mod claimed and
refuses any other id.

The claimed-id set becomes an id -> owner table (same lazy, lock-free
build once registrations are closed).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: [AI session link removed]
---
 src/Imlight.CoreLib/Modding/ImlightModding.cs | 32 +++++++++----
 .../Modding/ModMessageService.cs              | 47 ++++++++++++++++++-
 2 files changed, 67 insertions(+), 12 deletions(-)

diff --git a/src/Imlight.CoreLib/Modding/ImlightModding.cs b/src/Imlight.CoreLib/Modding/ImlightModding.cs
index baf70a6a..0b67f882 100644
--- a/src/Imlight.CoreLib/Modding/ImlightModding.cs
+++ b/src/Imlight.CoreLib/Modding/ImlightModding.cs
@@ -68,7 +68,7 @@ public static class ImlightModding {
 
     private static readonly object s_attachLock = new();
     private static Dictionary<string, RegistryEntry<ModCommand>> s_commands;
-    private static HashSet<uint> s_claimedJobs;
+    private static Dictionary<uint, string> s_jobOwners;
 
     /// <summary>The mod event bus, or an inert bus when no loader is attached.</summary>
     public static IEventBus Events { get; private set; } = NullEventBus.Instance;
@@ -138,9 +138,19 @@ public static class ImlightModding {
     /// Imlight's own client process handling (minigames) ignores claimed ids, and never allocates them.
     /// </summary>
     public static bool IsClientProcessJobClaimed(uint jobId) {
-        var claimed = Volatile.Read(ref s_claimedJobs) ?? BuildClaimedJobs();
+        var owners = Volatile.Read(ref s_jobOwners) ?? BuildJobOwners();
 
-        return claimed.Count != 0 && claimed.Contains(jobId);
+        return owners.Count != 0 && owners.ContainsKey(jobId);
+    }
+
+    /// <summary>
+    /// The id of the mod that claimed <paramref name="jobId"/> in <see cref="ImlightRegistries.ClientProcessJobs"/>,
+    /// or null when no mod did.
+    /// </summary>
+    internal static string GetClientProcessJobOwner(uint jobId) {
+        var owners = Volatile.Read(ref s_jobOwners) ?? BuildJobOwners();
+
+        return owners.Count != 0 && owners.TryGetValue(jobId, out var owner) ? owner : null;
     }
 
     /// <summary>
@@ -214,18 +224,19 @@ public static class ImlightModding {
         return true;
     }
 
-    private static HashSet<uint> BuildClaimedJobs() {
-        // Registrations are closed by the time any session exists, so building the set once is safe.
-        var claimed = new HashSet<uint>();
+    private static Dictionary<uint, string> BuildJobOwners() {
+        // Registrations are closed by the time any session exists, so building the table once is safe. The
+        // registry rejects a second claim of an id, so every id has one owner.
+        var owners = new Dictionary<uint, string>();
         if (Registries.TryGet(ImlightRegistries.ClientProcessJobs, out var registry)) {
             foreach (var entry in registry.Entries) {
-                claimed.Add(entry.Value);
+                owners.TryAdd(entry.Value, entry.OwnerModId);
             }
         }
 
-        _ = Interlocked.CompareExchange(ref s_claimedJobs, claimed, null);
+        _ = Interlocked.CompareExchange(ref s_jobOwners, owners, null);
 
-        return Volatile.Read(ref s_claimedJobs);
+        return Volatile.Read(ref s_jobOwners);
     }
 
     private static Dictionary<string, RegistryEntry<ModCommand>> GetCommands() {
@@ -270,7 +281,8 @@ public static class ImlightRegistries {
     /// Client process job ids (<c>MSG_START_CLIENT_PROCESS.JobID</c>) a mod uses for its own client scripts. Claimed
     /// ids are unique across mods (a second claim fails that mod's initialization) and cannot be zero. Imlight's
     /// <c>MinigameService</c> ignores <c>MSG_MESSAGE_PROCESS</c> for claimed ids, and its process supervisor never
-    /// allocates them, so the mod's own service receives the client's replies undisturbed.
+    /// allocates them. <c>MSG_MESSAGE_PROCESS</c> and <c>MSG_CLIENT_PROCESS_TERMINATED</c> for a claimed id reach only
+    /// the <see cref="ModMessageService"/>s of the mod that claimed it; for an unclaimed id they reach no mod service.
     /// </summary>
     public static RegistryKey<uint> ClientProcessJobs { get; } = new("imlight:client_process_jobs");
 
diff --git a/src/Imlight.CoreLib/Modding/ModMessageService.cs b/src/Imlight.CoreLib/Modding/ModMessageService.cs
index ad020fa4..2a5f06ad 100644
--- a/src/Imlight.CoreLib/Modding/ModMessageService.cs

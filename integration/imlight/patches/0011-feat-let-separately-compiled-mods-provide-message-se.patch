+/// <summary>
+/// Base class for a message service provided by a mod. Register the derived type in
+/// <see cref="ImlightRegistries.GameMessageServices"/> or <see cref="ImlightRegistries.LoginMessageServices"/>;
+/// Imlight creates one instance per session (public parameterless constructor) and calls its
+/// <see cref="MessageHandlerAttribute"/> methods for the client and server messages they declare, exactly as it
+/// does for its own services.
+/// </summary>
+/// <remarks>
+/// Handlers run on the session's actor thread, one message at a time. Do not block, and do not use an instance
+/// from another thread. Handler methods must be declared on the registered type itself or be non-private on a
+/// base class. The session helpers below are available from the first handler call onwards, not in the
+/// constructor.
+/// </remarks>
+public abstract class ModMessageService {
+
+    private ModMessageServiceHost _host;
+
+    /// <summary>The id of the mod that registered this service.</summary>
+    protected string OwnerModId { get; private set; }
+
+    /// <summary>The id of the session (client connection) this instance belongs to.</summary>
+    protected ushort SessionId => Host.SessionId;
+
+    private ModMessageServiceHost Host
+        => _host ?? throw new InvalidOperationException(
+            $"{GetType().FullName} is not attached to a session yet; use the session helpers from message handlers.");
+
+    /// <summary>Sends a message to this session's client.</summary>
+    protected void SendToSocket(IMessage message) {
+        ArgumentNullException.ThrowIfNull(message);
+        Host.SendToClient(message);
+    }
+
+    /// <summary>
+    /// The account connected to this session. Asked once from the session's account service (the same ask
+    /// Imlight's own services make) and then cached.
+    /// </summary>
+    protected Account GetSocketAccount() => Host.GetAccount();
+
+    /// <summary>
+    /// Called once when the session ends, while the session's other services still run (Imlight's pre-dispose
+    /// step, which waits at most two seconds for all services). Release per-session state here; keep it short.
+    /// </summary>
+    protected virtual void OnSessionEnded() { }
+
+    internal void Attach(ModMessageServiceHost host, string ownerModId) {
+        _host = host;
+        OwnerModId = ownerModId;
+    }
+
+    internal void NotifySessionEnded() => OnSessionEnded();
+
+}
+
+/// <summary>
+/// The MessageService that carries a session's mod services. Added to a service factory once when at least one
+/// <see cref="ModMessageService"/> type is registered for it; absent otherwise.
+/// </summary>
+internal abstract class ModMessageServiceHost : MessageService {
+
+    private static readonly ConcurrentDictionary<Type, ServiceSet> s_serviceSets = new();
+
+    private readonly List<(ModMessageService Service, string OwnerModId)> _services = [];
+    private Account _account;
+
+    protected ModMessageServiceHost(SessionActor sessionActor, RegistryKey<Type> key) : base(sessionActor) {
+        var set = s_serviceSets.GetOrAdd(GetType(), hostType => ServiceSet.Build(hostType, key));
+
+        // The session's dispatch table is built from these keys, so it routes the mod services' messages here.
+        MessageHandlers = set.MessageHandlers;
+
+        foreach (var (type, ownerModId) in set.Services) {
+            try {
+                var service = (ModMessageService) Activator.CreateInstance(type);
+                service.Attach(this, ownerModId);
+                _services.Add((service, ownerModId));
+            } catch (Exception ex) {
+                var cause = ex is TargetInvocationException { InnerException: not null } ? ex.InnerException : ex;
+                Logger.Error("Message service {0} of mod {1} could not be created for session {2} and is disabled " +
+                             "for it: {3}", Logger.Args(type.FullName, ownerModId, sessionActor.SessionID, cause));
+            }
+        }
+    }
+
+    internal ushort SessionId => SessionActor.SessionID;
+
+    internal void SendToClient(IMessage message) => SendToSocket(message);
+
+    internal Account GetAccount() => _account ??= GetSocketAccount();
+
+    protected override void ConfigureReceivers() => Receive<object>(Dispatch);
+
+    // Pre-dispose rather than dispose: the session waits for every service's pre-dispose reply, but stops its
+    // children right after telling them MSG_DISPOSE, so a dispose message can be dropped.
+    protected override void OnPreDispose() {
+        foreach (var (service, ownerModId) in _services) {
+            try {
+                service.NotifySessionEnded();
+            } catch (Exception ex) {
+                Logger.Error("Message service {0} of mod {1} failed while its session ended: {2}",
+                    Logger.Args(service.GetType().FullName, ownerModId, ex));
+            }
+        }
+
+        base.OnPreDispose();
+    }
+
+    private void Dispatch(object message) {
+        var messageType = message.GetType();
+        var handled = false;
+
+        // The host's own MessageService handlers (identity, dispose) first.
+        var own = MessageHandlerTable.DispatcherFor(GetType(), messageType);
+        if (own is not null) {
+            own(this, message);
+            handled = true;
+        }
+
+        foreach (var (service, ownerModId) in _services) {
+            var handler = MessageHandlerTable.DispatcherFor(service.GetType(), messageType);
+            if (handler is null) {
+                continue;
+            }
+
+            handled = true;
+            try {
+                handler(service, message);
+            } catch (Exception ex) {
+                Logger.Error("Message service {0} of mod {1} failed to handle {2}: {3}",
+                    Logger.Args(service.GetType().FullName, ownerModId, messageType.Name, ex));
+            }
+        }
+
+        if (!handled) {
+            Unhandled(message);
+        }
+    }
+
+    /// <summary>The registered mod service types of one host type, and the message types they handle.</summary>
+    private sealed class ServiceSet {
+
+        public (Type Type, string OwnerModId)[] Services { get; private init; }
+        public Dictionary<Type, MethodInfo> MessageHandlers { get; private init; }
+
+        public static ServiceSet Build(Type hostType, RegistryKey<Type> key) {
+            // Registrations are closed by the time any session exists, so the set is built once and only read.
+            var services = new List<(Type, string)>();
+            var handlers = new Dictionary<Type, MethodInfo>(MessageHandlerTable.HandlersOf(hostType));
+            var seen = new HashSet<Type>();
+            foreach (var entry in ImlightModding.ModServiceEntries(key)) {
+                if (!seen.Add(entry.Value)) {
+                    continue;
+                }
+
+                services.Add((entry.Value, entry.OwnerModId));
+                foreach (var (messageType, method) in MessageHandlerTable.HandlersOf(entry.Value)) {
+                    handlers.TryAdd(messageType, method);
+                }
+            }
+
+            return new ServiceSet { Services = [.. services], MessageHandlers = handlers };
+        }
+
+    }
+
+}
+
+/// <summary>Carries the game sessions' mod services.</summary>
+internal sealed class GameModMessageServiceHost(SessionActor sessionActor)
+    : ModMessageServiceHost(sessionActor, ImlightRegistries.GameMessageServices);
+
+/// <summary>Carries the login sessions' mod services.</summary>
+internal sealed class LoginModMessageServiceHost(SessionActor sessionActor)
+    : ModMessageServiceHost(sessionActor, ImlightRegistries.LoginMessageServices);

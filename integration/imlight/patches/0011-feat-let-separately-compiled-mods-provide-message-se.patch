+ * ========================================================================
+ * MOD MESSAGE SERVICES
+ * ========================================================================
+ *
+ * PURPOSE:
+ * Lets separately compiled mods handle session messages. MessageService is internal, so a mod cannot derive
+ * from it; a mod derives from the public ModMessageService instead and registers the type in
+ * ImlightRegistries.GameMessageServices or LoginMessageServices. Each session then gets one internal
+ * ModMessageServiceHost (a real MessageService child of the SessionActor) that creates the mod services and
+ * dispatches messages to their [MessageHandler] methods on its own actor thread.
+ *
+ * USAGE EXAMPLE:
+ * public sealed class MenuReplies : ModMessageService {
+ *     [MessageHandler(typeof(GAME_5_PROTOCOL.MSG_MESSAGE_PROCESS))]
+ *     private void OnReply(GAME_5_PROTOCOL.MSG_MESSAGE_PROCESS message) { ... }
+ * }
+ * context.Registries.Get(ImlightRegistries.LoginMessageServices).Register("menu", typeof(MenuReplies));
+ *
+ * NOTE:
+ * Mod services are plain objects owned by the host actor: their handlers run synchronously inside the host's
+ * message processing, one message at a time, like any other service. An exception from a mod service is
+ * logged against its mod and does not stop the session or the other services.
+ *
+ * TODO:
+ *
+ * Created by: SpiralLoader contributors
+ * Version: KALI 1.0
+ * Last Updated: 10/20/2026
+ */

+[SpiralLoader]
+; SpiralLoader mod loader. With no mods installed Imlight behaves exactly as it does without the loader.
+; Mods are folders containing a spiralmod.json inside ModsDirectory. Changing mods requires a restart.
+Enabled = true
+; Relative paths resolve against the server directory.
+ModsDirectory = mods
+DataDirectory = moddata
+ConfigDirectory = Config/mods

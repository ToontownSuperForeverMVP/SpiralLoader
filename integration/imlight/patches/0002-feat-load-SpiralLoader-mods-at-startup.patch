+
+    private static bool StartModLoader() {
+        try {
+            var loader = SpiralLoader.Imlight.ImlightModLoader.Start(new SpiralLoader.Imlight.ImlightLoaderOptions {
+                BaseDirectory = AppDomain.CurrentDomain.BaseDirectory,
+                Settings = ConfigurationManager.GetSection("SpiralLoader"),
+                IntegrationApiVersion = ImlightModding.IntegrationApiVersion,
+                ImlightCommit = SpiralLoader.Imlight.ImlightModLoader.ReadStampedCommit(typeof(Program).Assembly),
+                ClientRevision = ConfigurationManager.GetSetting("Global Settings.GameRevision"),
+                Log = WriteModLog,
+                DeclareRegistries = host => {
+                    host.AddRegistry(ImlightRegistries.GameMessageServices, ImlightModding.ValidateMessageService);
+                    host.AddRegistry(ImlightRegistries.LoginMessageServices, ImlightModding.ValidateMessageService);
+                    host.AddRegistry(SpiralLoader.Api.Commands.CommonRegistries.Commands,
+                        SpiralLoader.Runtime.ModCommandRouter.Validate);
+                },
+            });
+
+            // Null when [SpiralLoader] Enabled = false: Imlight keeps its inert event bus.
+            if (loader is not null) {
+                ImlightModding.Attach(loader.Events, loader.Registries);
+            }
+
+            return true;
+        } catch (SpiralLoader.Runtime.ModLoadException) {
+            Logger.Fatal("SpiralLoader could not load the installed mods (see the report above). Fix or remove " +
+                         "them, or set FailurePolicy = Continue in the [SpiralLoader] section of Imlight.ini.");
+
+            return false;
+        }
+    }
+
+    private static void WriteModLog(ModLogLevel level, string source, string message, Exception exception) {
+        var args = Logger.Args(source, exception is null ? message : $"{message}{Environment.NewLine}{exception}");
+        switch (level) {
+            case ModLogLevel.Trace:
+                Logger.Verbose("[{0}] {1}", args);
+                break;
+            case ModLogLevel.Debug:
+                Logger.Debug("[{0}] {1}", args);
+                break;
+            case ModLogLevel.Information:
+                Logger.Information("[{0}] {1}", args);
+                break;
+            case ModLogLevel.Warning:
+                Logger.Warning("[{0}] {1}", args);
+                break;
+            case ModLogLevel.Error:
+                Logger.Error("[{0}] {1}", args);
+                break;
+            default:
+                Logger.Fatal("[{0}] {1}", args);
+                break;
+        }
+    }
     private static IActorRef StartLoginServer() {
         var loginServerName = s_loginServerName;
         var loginServerPort = s_loginServerPort;

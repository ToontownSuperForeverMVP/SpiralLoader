--- /dev/null
+++ b/src/Imlight.CoreLib/Modding/ImlightModding.cs
@@ -0,0 +1,208 @@
+/*
+ * Imlight
+ * Copyright (C) 2025 Revive101
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU Affero General Public License for more details.
+ *
+ * You should have received a copy of the GNU Affero General Public License
+ * along with this program. If not, see <http://www.gnu.org/licenses/>.
+ *
+ * ========================================================================
+ * MOD INTEGRATION
+ * ========================================================================
+ *
+ * PURPOSE:
+ * Connects Imlight to SpiralLoader. Holds the event bus and registries the mod loader attaches at startup,
+ * and the helpers Imlight's call sites use to consult them. Without a loader attached, every member is inert
+ * and Imlight behaves exactly as it does unmodded.
+ *
+ * USAGE EXAMPLE:
+ * if (ImlightModding.Events.HasSubscribers<LootGrantingEvent>()) {
+ *     ImlightModding.Events.Publish(new LootGrantingEvent(playerActor, wizard, results));
+ * }
+ *
+ * NOTE:
+ * Event handlers run synchronously on the publishing actor's thread. Registrations close once mods have
+ * initialized, so the bus and registries are immutable while the server runs.
+ *
+ * TODO:
+ * - More hook points (see SpiralLoader docs/next-milestone.md).
+ *
+ * Created by: SpiralLoader contributors
+ * Version: KALI 1.0
+ * Last Updated: 10/19/2026
+ */
+
+using System;
+using System.Collections.Generic;
+using System.Threading;
+using Imlight.Common;
+using Imlight.CoreLib.Shared.Networking;
+using Imlight.CoreLib.WizardData.Models.Player;
+using SpiralLoader.Api.Commands;
+using SpiralLoader.Api.Events;
+using SpiralLoader.Api.Registries;
+
+namespace Imlight.CoreLib.Modding;
+
+/// <summary>
+/// Imlight's connection to the SpiralLoader mod loader.
+/// </summary>
+public static class ImlightModding {
+
+    /// <summary>
+    /// Version of Imlight's mod-facing surface (events, registries, behaviors). Exposed to mods as the
+    /// <c>imlight</c> dependency. Bump the major version on breaking changes to any of it.
+    /// </summary>
+    public const string IntegrationApiVersion = "1.0.0";
+
+    private const string NoPermissionReply = "You do not have permission to use this command.";
+
+    private static readonly object s_attachLock = new();
+    private static Dictionary<string, RegistryEntry<ModCommand>> s_commands;
+
+    /// <summary>The mod event bus, or an inert bus when no loader is attached.</summary>
+    public static IEventBus Events { get; private set; } = NullEventBus.Instance;
+
+    /// <summary>The mod registries, or an empty provider when no loader is attached.</summary>
+    public static IRegistryProvider Registries { get; private set; } = EmptyRegistryProvider.Instance;
+
+    public static bool IsAttached { get; private set; }
+
+    /// <summary>
+    /// Attaches the loaded mods. Called once by the Director, after mods initialize and before any server starts.
+    /// </summary>
+    public static void Attach(IEventBus events, IRegistryProvider registries) {
+        ArgumentNullException.ThrowIfNull(events);
+        ArgumentNullException.ThrowIfNull(registries);
+
+        lock (s_attachLock) {
+            if (IsAttached) {
+                throw new InvalidOperationException("A mod loader is already attached.");
+            }
+
+            Events = events;
+            Registries = registries;
+            IsAttached = true;
+        }
+    }
+
+    /// <summary>
+    /// Validator for <see cref="ImlightRegistries.GameMessageServices"/> and
+    /// <see cref="ImlightRegistries.LoginMessageServices"/>. Returns null when the type is usable.
+    /// </summary>
+    public static string ValidateMessageService(Type type) {
+        if (type is null) {
+            return "the service type is null.";
+        }
+
+        if (!typeof(MessageService).IsAssignableFrom(type)) {
+            return $"{type.FullName} does not derive from Imlight's MessageService.";
+        }
+
+        if (type.IsAbstract || type.ContainsGenericParameters) {
+            return $"{type.FullName} must be a concrete, non-generic class.";
+        }
+
+        if (type.GetConstructor([typeof(SessionActor)]) is null) {
+            return $"{type.FullName} needs a public constructor taking a SessionActor.";
+        }
+
+        return null;
+    }
+
+    /// <summary>
+    /// Adds the message services mods registered under <paramref name="key"/> to a factory's built-in set.
+    /// </summary>
+    internal static HashSet<Type> WithModServices(RegistryKey<Type> key, HashSet<Type> builtIn) {
+        if (!Registries.TryGet(key, out var registry)) {
+            return builtIn;
+        }
+
+        foreach (var entry in registry.Entries) {
+            if (builtIn.Add(entry.Value)) {
+                Logger.Information("Mod {0} added message service {1} ({2}).",
+                    Logger.Args(entry.OwnerModId, entry.Value.FullName, key.Name));
+            }
+        }
+
+        return builtIn;
+    }
+
+    /// <summary>
+    /// Runs a mod-registered command. Returns false when no mod registered the command word.
+    /// </summary>
+    internal static bool TryExecuteCommand(string commandLine, Account account, out string reply) {
+        reply = null;
+        var commands = GetCommands();
+        if (commands.Count == 0) {
+            return false;
+        }
+
+        var parts = commandLine.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
+        if (parts.Length == 0 || !commands.TryGetValue(parts[0], out var entry)) {
+            return false;
+        }
+
+        var isOperator = account is not null && account.AuthLevel >= AuthLevel.Administrator;
+        if (entry.Value.OperatorOnly && !isOperator) {
+            reply = NoPermissionReply;
+            return true;
+        }
+
+        try {
+            reply = entry.Value.Execute(new ModCommandInvocation(parts[1..], account?.Username ?? "unknown", isOperator));
+        } catch (Exception ex) {
+            Logger.Error("Command {0} from mod {1} threw: {2}", Logger.Args(parts[0], entry.OwnerModId, ex.ToString()));
+            reply = "The command failed. See the server log.";
+        }
+
+        return true;
+    }
+
+    private static Dictionary<string, RegistryEntry<ModCommand>> GetCommands() {
+        var commands = Volatile.Read(ref s_commands);
+        if (commands is not null) {
+            return commands;
+        }
+
+        // Registrations are closed by the time any command arrives, so building the table once is safe.
+        commands = new Dictionary<string, RegistryEntry<ModCommand>>(StringComparer.OrdinalIgnoreCase);
+        if (Registries.TryGet(CommonRegistries.Commands, out var registry)) {
+            foreach (var entry in registry.Entries) {
+                if (!commands.TryAdd(entry.Value.Name, entry)) {
+                    Logger.Warning("Command {0} from mod {1} is ignored: mod {2} registered it first.",
+                        Logger.Args(entry.Value.Name, entry.OwnerModId, commands[entry.Value.Name].OwnerModId));
+                }
+            }
+        }
+
+        _ = Interlocked.CompareExchange(ref s_commands, commands, null);
+        return Volatile.Read(ref s_commands);
+    }
+
+}
+
+/// <summary>
+/// Registries Imlight consumes. Mods contribute through <c>context.Registries.Get(...)</c> during initialization.
+/// </summary>
+public static class ImlightRegistries {
+
+    /// <summary>
+    /// Extra message services attached to every game session. Values are <see cref="Type"/>s deriving from
+    /// Imlight's MessageService with a public constructor taking a SessionActor.
+    /// </summary>
+    public static RegistryKey<Type> GameMessageServices { get; } = new("imlight:game_message_services");
+
+    /// <summary>Extra message services attached to every login session.</summary>
+    public static RegistryKey<Type> LoginMessageServices { get; } = new("imlight:login_message_services");
+
+}

+ *
+ * ========================================================================
+ * ASSEMBLY TYPES
+ * ========================================================================
+ *
+ * PURPOSE:
+ * Enumerates an assembly's types for the registries that scan every loaded assembly, without letting one
+ * assembly with an unresolvable reference (for example, a broken mod) break the whole scan.
+ *
+ * USAGE EXAMPLE:
+ * AppDomain.CurrentDomain.GetAssemblies().SelectMany(AssemblyTypes.LoadableTypes)
+ *
+ * NOTE:
+ *
+ * TODO:
+ *
+ * Created by: SpiralLoader contributors
+ * Version: KALI 1.0
+ * Last Updated: 10/19/2026
+ */
+
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using Imlight.Common;
+
+namespace Imlight.CoreLib.Shared.Utilities;
+
+internal static class AssemblyTypes {
+
+    /// <summary>
+    /// Returns every type of <paramref name="assembly"/> that can be loaded, logging the ones that cannot.
+    /// </summary>
+    public static IEnumerable<System.Type> LoadableTypes(Assembly assembly) {
+        try {
+            return assembly.GetTypes();
+        } catch (ReflectionTypeLoadException ex) {
+            Logger.Warning("Skipped {0} type(s) from {1} that could not be loaded: {2}",
+                Logger.Args(ex.Types.Count(t => t is null), assembly.GetName().Name,
+                    ex.LoaderExceptions.FirstOrDefault()?.Message ?? "unknown error"));
+
+            return ex.Types.Where(t => t is not null);
+        }
+    }
+
+}
